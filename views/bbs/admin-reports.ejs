<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '신고 관리' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">신고 관리</h1>
                <p class="text-secondary mb-0">접수된 게시글과 댓글 신고를 처리합니다.</p>
            </div>
            <a href="/bbs/admin" class="btn btn-outline-secondary px-4">대시보드</a>
        </div>

        <section class="card board-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 70px;">번호</th>
                                <th scope="col">대상</th>
                                <th scope="col" style="width: 110px;">신고자</th>
                                <th scope="col" style="width: 120px;">사유</th>
                                <th scope="col" style="width: 110px;">상태</th>
                                <th scope="col" class="text-end" style="width: 300px;">처리</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (rows.length) { %>
                                <% rows.forEach(function(row) { %>
                                    <tr>
                                        <td class="text-secondary"><%= row[0] %></td>
                                        <td>
                                            <div class="fw-semibold"><%= row[1] === 'POST' ? '게시글' : '댓글' %> #<%= row[2] %></div>
                                            <div class="small text-secondary text-truncate" style="max-width: 360px;"><%= row[10] || '-' %></div>
                                            <% if (row[1] === 'POST') { %>
                                                <a href="/bbs/read?brdno=<%= row[2] %>" class="small">대상 보기</a>
                                            <% } %>
                                        </td>
                                        <td><%= row[3] %></td>
                                        <td><span class="badge text-bg-light border"><%= row[4] %></span></td>
                                        <td><span class="badge <%= row[6] === 'PENDING' ? 'text-bg-warning' : row[6] === 'HIDDEN' ? 'text-bg-danger' : 'text-bg-light border' %>"><%= row[6] %></span></td>
                                        <td>
                                            <form action="/bbs/admin/reports/handle" method="post" class="d-flex justify-content-end gap-2">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="report_no" value="<%= row[0] %>">
                                                <input type="hidden" name="target_type" value="<%= row[1] %>">
                                                <input type="hidden" name="target_id" value="<%= row[2] %>">
                                                <select class="form-select form-select-sm w-auto" name="status">
                                                    <option value="REJECTED">반려</option>
                                                    <option value="RESOLVED">해결</option>
                                                    <option value="HIDDEN">숨김</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-primary">처리</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center text-secondary py-5">접수된 신고가 없습니다.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
