<!DOCTYPE html>
<html>
<%- include('partials/head', { title: 'Write Post' }) %>
<body>
    <%- include('partials/nav') %>

    <main class="container py-4">
        <div class="card form-card mx-auto">
            <div class="card-header bg-white">
                <h1 class="h4 mb-0">글쓰기</h1>
            </div>
            <div class="card-body">
                <form name="form1" action="/bbs/save" method="post">
                    <div class="mb-3">
                        <label class="form-label" for="brdwriter">작성자</label>
                        <input class="form-control" type="text" id="brdwriter" name="brdwriter" size="20" maxlength="20" value="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="brdtitle">제목</label>
                        <input class="form-control" type="text" id="brdtitle" name="brdtitle" size="70" maxlength="250" value="">
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="brdmemo">내용</label>
                        <textarea class="form-control" id="brdmemo" name="brdmemo" rows="8" cols="60"></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a href="/bbs/list" class="btn btn-secondary">목록</a>
                        <button type="submit" class="btn btn-primary">저장</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
