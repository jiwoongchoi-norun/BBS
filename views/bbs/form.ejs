<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '글쓰기' }) %>

<body>
    <%- include('partials/nav') %>

    <%
        var savedForm = typeof formData !== 'undefined' ? formData : {};
        var categoryRows = typeof categories !== 'undefined' ? categories : [];
    %>

    <main class="container py-4 py-lg-5">
        <div class="card board-card form-card mx-auto">
            <div class="card-header bg-white">
                <h1 class="h4 fw-bold mb-0">글쓰기</h1>
            </div>
            <div class="card-body">
                <form name="form1" action="/bbs/save?_csrf=<%= csrfToken %>" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="category_id">카테고리</label>
                        <select class="form-select" id="category_id" name="category_id">
                            <option value="">미분류</option>
                            <% categoryRows.forEach(function(category) { %>
                                <option value="<%= category[0] %>" <%= Number(savedForm.categoryId || 0) === Number(category[0]) ? 'selected' : '' %>>
                                    <%= category[1] %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="brdtitle">제목</label>
                        <input class="form-control" type="text" id="brdtitle" name="brdtitle" maxlength="200"
                            value="<%= savedForm.title || '' %>">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="brdmemo">내용</label>
                        <textarea class="form-control" id="brdmemo" name="brdmemo" rows="8" maxlength="4000"><%= savedForm.content || '' %></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="uploadFile">첨부파일</label>
                        <input class="form-control" type="file" id="uploadFile" name="uploadFile">
                        <div class="form-text">10MB 이하 파일만 업로드할 수 있습니다.</div>
                    </div>
                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a href="/bbs/list" class="btn btn-outline-secondary btn-action">목록</a>
                        <button type="submit" class="btn btn-primary btn-action">저장</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
