<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '로그인' }) %>

<body>
    <%- include('partials/nav') %>

    <% if(errcode == 1) { %>
        <script>
            alert('로그인 아이디가 없습니다.');
        </script>
    <% } %>

    <% if(errcode == 2) { %>
        <script>
            alert('비밀번호가 틀립니다.');
        </script>
    <% } %>

    <% if(errcode == 3) { %>
        <script>
            alert('이미 로그인되어 있습니다.');
            window.setTimeout(function() {
                location.href='http://localhost:3000/bbs/';
            }, 1000);
        </script>
    <% } %>

    <main class="container py-4 py-lg-5">
        <div class="card board-card auth-card mx-auto">
            <div class="card-header bg-white">
                <h1 class="h4 fw-bold mb-0">로그인</h1>
            </div>
            <div class="card-body">
                <form name="form1" action="/bbs/logincheck" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="id">아이디</label>
                        <input class="form-control" type="text" id="id" name="id" placeholder="id" value="">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="password">비밀번호</label>
                        <input class="form-control" type="password" id="password" name="password" placeholder="password" value="">
                    </div>
                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a href="/bbs/list" class="btn btn-outline-secondary btn-action">목록</a>
                        <button type="submit" class="btn btn-primary btn-action">로그인</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
