<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '글수정' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <%
            var column = rows[0];
            var fileRows = typeof files !== 'undefined' ? files : [];

            function formatFileSize(bytes) {
                bytes = Number(bytes || 0);
                if (bytes >= 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
                if (bytes >= 1024) return Math.ceil(bytes / 1024) + ' KB';
                return bytes + ' B';
            }
        %>
        <div class="card board-card form-card mx-auto">
            <div class="card-header bg-white">
                <h1 class="h4 fw-bold mb-0">글수정</h1>
            </div>
            <div class="card-body">
                <form name="form1" action="/bbs/updatesave" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="brdwriter">작성자</label>
                        <input class="form-control" type="text" id="brdwriter" name="brdwriter"
                            maxlength="20" value="<%=column[3]%>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="brdtitle">제목</label>
                        <input class="form-control" type="text" id="brdtitle" name="brdtitle"
                            maxlength="250" value="<%=column[1]%>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="brdmemo">내용</label>
                        <textarea class="form-control" id="brdmemo" name="brdmemo" rows="8"><%=column[2]%></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">작성일</label>
                        <div class="form-control bg-light"><%=column[4]%></div>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-2">
                            <div>
                                <label class="form-label fw-semibold mb-0">현재 첨부파일</label>
                                <div class="form-text mb-0">저장해도 기존 첨부파일은 그대로 유지됩니다.</div>
                            </div>
                            <span class="badge text-bg-light border align-self-start align-self-sm-center"><%= fileRows.length %>개</span>
                        </div>
                        <% if (fileRows.length) { %>
                            <div class="list-group list-group-flush border rounded">
                                <% for (var f = 0; f < fileRows.length; f++) {
                                    var file = fileRows[f];
                                    var fileSize = formatFileSize(file[5]);
                                    var fileType = file[6] || '파일 형식 정보 없음';
                                %>
                                    <div class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                        <div class="min-w-0">
                                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                                <span class="fw-semibold text-break"><%= file[2] %></span>
                                                <span class="badge text-bg-success">유지됨</span>
                                            </div>
                                            <div class="d-flex flex-wrap align-items-center gap-2 text-secondary small">
                                                <span class="badge text-bg-light border"><%= fileSize %></span>
                                                <span><%= fileType %></span>
                                                <span>등록 <%= file[7] %></span>
                                            </div>
                                        </div>
                                        <a class="btn btn-sm btn-outline-primary flex-shrink-0" href="/bbs/download?fno=<%=file[0]%>">다운로드</a>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div class="border rounded bg-light p-3 text-secondary">등록된 첨부파일이 없습니다.</div>
                        <% } %>
                    </div>
                    <input type="hidden" name="brdno" value="<%=column[0]%>">
                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a href="/bbs/read?brdno=<%=column[0]%>" class="btn btn-outline-secondary btn-action">취소</a>
                        <button type="submit" class="btn btn-primary btn-action">저장</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
