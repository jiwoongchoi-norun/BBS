<!DOCTYPE html>
<html>
<%- include('partials/head', { title: 'Sign Up' }) %>

<body>
    <%- include('partials/nav') %>

    <% if(code == 1) { %>
        <script>
            alert('이미 로그인되어 있습니다.');

            setTimeout(function() {
                location.href='http://localhost:3000/bbs/';
            }, 1000);
        </script>
    <% } %>

    <main class="container py-4">
        <div class="card auth-card mx-auto">
            <div class="card-header bg-white">
                <h1 class="h4 mb-0">회원가입</h1>
            </div>
            <div class="card-body">
                <form name="form1" action="/bbs/signupsave" method="post">
                    <div class="mb-3">
                        <label class="form-label" for="id">아이디</label>
                        <input class="form-control" type="text" id="id" name="id" size="20" maxlength="20" value="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="pw1">패스워드</label>
                        <input class="form-control" type="password" id="pw1" name="pw1" size="20" maxlength="20" value="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="pw2">패스워드 확인</label>
                        <input class="form-control" type="password" id="pw2" name="pw2" size="20" maxlength="20" value="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="name">이름</label>
                        <input class="form-control" type="text" id="name" name="name" size="20" maxlength="20" value="">
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="email">이메일</label>
                        <input class="form-control" type="email" id="email" name="email" size="20" maxlength="20" value="">
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a href="/bbs/list" class="btn btn-secondary">목록</a>
                        <a href="#" class="btn btn-primary" onclick="form1.submit()">저장</a>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
