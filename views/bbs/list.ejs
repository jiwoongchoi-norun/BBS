<!DOCTYPE html>
<html>

<%- include('partials/head', { title: '자유게시판' }) %>

<body>
    <%- include('partials/nav') %>
    <%
        var selectedChoice = typeof searchChoice !== 'undefined' ? searchChoice : 'TITLE';
        var selectedKeyword = typeof searchKeyword !== 'undefined' ? searchKeyword : '';
        var resultTotalCount = typeof totalCount !== 'undefined' ? totalCount : (rows ? rows.length : 0);
        var pageCurrent = typeof currentPage !== 'undefined' ? currentPage : 1;
        var pageTotal = typeof totalPage !== 'undefined' ? totalPage : 0;
        var pageStart = typeof startPage !== 'undefined' ? startPage : 1;
        var pageEnd = typeof endPage !== 'undefined' ? endPage : pageTotal;
        var pageBase = typeof paginationBaseUrl !== 'undefined' ? paginationBaseUrl : '';
        var showPagination = pageBase && pageTotal > 1;
        var currentPageSize = typeof pageSize !== 'undefined' ? pageSize : 10;
        var currentSort = typeof sort !== 'undefined' ? sort : '';
        var currentOrder = typeof order !== 'undefined' ? order : 'desc';
        var searchMode = typeof isSearch !== 'undefined' ? isSearch : !!selectedKeyword;
        var mineMode = typeof myPostsOnly !== 'undefined' ? myPostsOnly : false;
        var hasRows = rows && rows.length;
        var searchChoiceLabels = {
            TITLE: '제목',
            WRITER: '작성자',
            CONTENT: '내용',
            TITLE_CONTENT: '제목 + 내용'
        };
        var selectedChoiceLabel = searchChoiceLabels[selectedChoice] || '검색';
        var today = new Date();

        function padDateNumber(value) {
            return String(value).padStart(2, '0');
        }

        function formatListDate(value) {
            if (!value) return '';

            var match = String(value).match(/^(\d{4})-(\d{2})-(\d{2})\s+(\d{2}):(\d{2})/);
            if (!match) return value;

            var year = Number(match[1]);
            var month = Number(match[2]);
            var day = Number(match[3]);
            var hour = match[4];
            var minute = match[5];

            if (
                today.getFullYear() === year &&
                today.getMonth() + 1 === month &&
                today.getDate() === day
            ) {
                return hour + ':' + minute;
            }

            return padDateNumber(year % 100) + '.' + padDateNumber(month) + '.' + padDateNumber(day);
        }

        function nextSortOrder(sortName) {
            return currentSort === sortName && currentOrder === 'desc' ? 'asc' : 'desc';
        }

        function sortMark(sortName) {
            if (currentSort !== sortName) return '';
            return currentOrder === 'asc' ? '▲' : '▼';
        }

        function sortLink(sortName) {
            var params = [];

            if (searchMode) {
                params.push('choice=' + encodeURIComponent(selectedChoice));
                params.push('search=' + encodeURIComponent(selectedKeyword));
            }

            if (mineMode) {
                params.push('mine=1');
            }

            params.push('pageSize=' + encodeURIComponent(currentPageSize));
            params.push('sort=' + encodeURIComponent(sortName));
            params.push('order=' + encodeURIComponent(nextSortOrder(sortName)));

            return (searchMode ? '/bbs/search?' : '/bbs/list?') + params.join('&');
        }

        function filterLink(includeMine) {
            var params = [];

            if (searchMode) {
                params.push('choice=' + encodeURIComponent(selectedChoice));
                params.push('search=' + encodeURIComponent(selectedKeyword));
            }

            params.push('pageSize=' + encodeURIComponent(currentPageSize));

            if (includeMine) {
                params.push('mine=1');
            }

            if (currentSort) {
                params.push('sort=' + encodeURIComponent(currentSort));
                params.push('order=' + encodeURIComponent(currentOrder));
            }

            return (searchMode ? '/bbs/search?' : '/bbs/list?') + params.join('&');
        }
    %>

    <main class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">자유게시판</h1>
                <p class="text-secondary mb-0">게시글을 확인하고 원하는 글을 검색할 수 있습니다.</p>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2">
                <% if (currentUser) { %>
                    <% if (mineMode) { %>
                        <a href="<%= filterLink(false) %>" class="btn btn-outline-secondary px-4">전체 글 보기</a>
                    <% } else { %>
                        <a href="<%= filterLink(true) %>" class="btn btn-outline-primary px-4">내 글만 보기</a>
                    <% } %>
                <% } %>
                <a href="/bbs/form" class="btn btn-primary px-4">글쓰기</a>
            </div>
        </div>

        <section class="card board-card mb-4">
            <div class="card-body">
                <form action="/bbs/search">
                    <input type="hidden" name="pageSize" value="<%= currentPageSize %>">
                    <% if (mineMode) { %>
                        <input type="hidden" name="mine" value="1">
                    <% } %>
                    <% if (currentSort) { %>
                        <input type="hidden" name="sort" value="<%= currentSort %>">
                        <input type="hidden" name="order" value="<%= currentOrder %>">
                    <% } %>
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-7">
                            <label class="form-label fw-semibold">검색 조건</label>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="choice" id="searchTitle"
                                        value="TITLE" <%= selectedChoice === 'TITLE' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="searchTitle">제목</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="choice" id="searchWriter"
                                        value="WRITER" <%= selectedChoice === 'WRITER' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="searchWriter">작성자</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="choice" id="searchContent"
                                        value="CONTENT" <%= selectedChoice === 'CONTENT' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="searchContent">내용</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="choice" id="searchTitleContent"
                                        value="TITLE_CONTENT" <%= selectedChoice === 'TITLE_CONTENT' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="searchTitleContent">제목 + 내용</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <label class="form-label fw-semibold" for="searchKeyword">검색어</label>
                            <div class="input-group">
                                <input class="form-control" type="text" id="searchKeyword" name="search"
                                    placeholder="검색어를 입력하세요" value="<%= selectedKeyword %>">
                                <button class="btn btn-primary" type="submit">검색</button>
                            </div>
                        </div>
                    </div>
                </form>
                <form class="d-flex justify-content-end align-items-center gap-2 mt-3"
                    action="<%= searchMode ? '/bbs/search' : '/bbs/list' %>">
                    <% if (searchMode) { %>
                        <input type="hidden" name="choice" value="<%= selectedChoice %>">
                        <input type="hidden" name="search" value="<%= selectedKeyword %>">
                    <% } %>
                    <% if (mineMode) { %>
                        <input type="hidden" name="mine" value="1">
                    <% } %>
                    <% if (currentSort) { %>
                        <input type="hidden" name="sort" value="<%= currentSort %>">
                        <input type="hidden" name="order" value="<%= currentOrder %>">
                    <% } %>
                    <label class="form-label mb-0 text-secondary small" for="pageSizeSelect">페이지당</label>
                    <select class="form-select form-select-sm w-auto" id="pageSizeSelect" name="pageSize"
                        onchange="this.form.submit()">
                        <% [10, 20, 30, 50].forEach(function(size) { %>
                            <option value="<%= size %>" <%= Number(currentPageSize) === size ? 'selected' : '' %>>
                                <%= size %>개
                            </option>
                        <% }) %>
                    </select>
                </form>
            </div>
        </section>

        <section class="card board-card">
            <% if (hasRows) { %>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center" style="width: 90px;">번호</th>
                                <th scope="col">제목</th>
                                <th scope="col" style="width: 160px;">작성자</th>
                                <th scope="col" class="text-center" style="width: 110px;">
                                    <a class="link-dark text-decoration-none" href="<%= sortLink('views') %>">
                                        조회수 <span class="small text-primary"><%= sortMark('views') %></span>
                                    </a>
                                </th>
                                <th scope="col" class="text-center" style="width: 100px;">
                                    <a class="link-dark text-decoration-none" href="<%= sortLink('likes') %>">
                                        좋아요 <span class="small text-primary"><%= sortMark('likes') %></span>
                                    </a>
                                </th>
                                <th scope="col" style="width: 190px;">
                                    <a class="link-dark text-decoration-none" href="<%= sortLink('created_at') %>">
                                        작성일 <span class="small text-primary"><%= sortMark('created_at') %></span>
                                    </a>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for(var i=0; i<rows.length; i++){ var column=rows[i]; var postId = column[0]; var displayNo = resultTotalCount - ((pageCurrent - 1) * currentPageSize) - i; var commentCount = column[9] || 0; %>
                                    <tr>
                                        <td class="text-center text-secondary"><%=displayNo%></td>
                                        <td>
                                            <a class="d-inline-block text-truncate text-decoration-none fw-semibold text-dark"
                                                style="max-width: min(520px, 55vw);"
                                                href="/bbs/read?brdno=<%=postId%>"
                                                title="<%=column[1]%>">
                                                <%=column[1]%>
                                            </a>
                                            <span class="ms-1 small <%= commentCount > 0 ? 'text-primary fw-semibold' : 'text-secondary' %>">[<%=commentCount%>]</span>
                                        </td>
                                        <td class="text-secondary"><%=column[2]%></td>
                                        <td class="text-center"><%=column[5]%></td>
                                        <td class="text-center"><%=column[7] || 0%></td>
                                        <td class="text-secondary"><%=formatListDate(column[4])%></td>
                                    </tr>
                                <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } else { %>
            <div class="card-body text-center py-5 px-4">
                <% if (searchMode && selectedKeyword) { %>
                    <p class="fw-semibold mb-2">검색 결과가 없습니다.</p>
                    <p class="text-secondary mb-4">
                        <% if (mineMode) { %>내 글 중 <% } %>
                        <span class="fw-semibold text-dark"><%= selectedChoiceLabel %></span>에서
                        "<span class="fw-semibold text-dark"><%= selectedKeyword %></span>"에 대한 게시글을 찾지 못했습니다.
                    </p>
                    <a href="/bbs/list" class="btn btn-outline-primary">전체 목록 보기</a>
                <% } else if (mineMode) { %>
                    <p class="fw-semibold mb-2">작성한 게시글이 없습니다.</p>
                    <p class="text-secondary mb-4">내가 작성한 글만 이 화면에 표시됩니다.</p>
                    <a href="/bbs/list" class="btn btn-outline-primary">전체 글 보기</a>
                <% } else { %>
                    <p class="fw-semibold mb-2">등록된 게시글이 없습니다.</p>
                    <p class="text-secondary mb-4">첫 번째 게시글을 작성해 보세요.</p>
                    <a href="/bbs/form" class="btn btn-primary">글쓰기</a>
                <% } %>
            </div>
            <% } %>
        </section>

        <% if (showPagination) { %>
            <nav class="mt-4" aria-label="게시글 페이지">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item <%= pageCurrent <= 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="<%= pageCurrent <= 1 ? '#' : pageBase + (pageCurrent - 1) %>">이전</a>
                    </li>

                    <% for (var pageNo = pageStart; pageNo <= pageEnd; pageNo++) { %>
                        <li class="page-item <%= pageNo === pageCurrent ? 'active' : '' %>">
                            <a class="page-link" href="<%= pageBase + pageNo %>"><%= pageNo %></a>
                        </li>
                    <% } %>

                    <li class="page-item <%= pageCurrent >= pageTotal ? 'disabled' : '' %>">
                        <a class="page-link" href="<%= pageCurrent >= pageTotal ? '#' : pageBase + (pageCurrent + 1) %>">다음</a>
                    </li>
                </ul>
            </nav>
        <% } %>
    </main>
    <%- include('partials/footer') %>
</body>

</html>
