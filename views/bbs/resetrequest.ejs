<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '비밀번호 재설정' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <%
            var data = typeof formData !== 'undefined' ? formData : {};
            var resultMessage = typeof message !== 'undefined' ? message : '';
            var resultLink = typeof resetLink !== 'undefined' ? resetLink : '';
        %>
        <div class="card board-card auth-card mx-auto">
            <div class="card-header bg-white">
                <h1 class="h4 fw-bold mb-0">비밀번호 재설정</h1>
            </div>
            <div class="card-body">
                <form action="/bbs/reset-password/request" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="id">아이디</label>
                        <input class="form-control" type="text" id="id" name="id" maxlength="20"
                            value="<%= data.id || '' %>" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="email">이메일</label>
                        <input class="form-control" type="email" id="email" name="email" maxlength="200"
                            value="<%= data.email || '' %>" required>
                    </div>

                    <% if (resultMessage) { %>
                        <div class="alert <%= resultLink ? 'alert-success' : 'alert-warning' %>">
                            <div><%= resultMessage %></div>
                            <% if (resultLink) { %>
                                <a class="fw-semibold" href="<%= resultLink %>"><%= resultLink %></a>
                            <% } %>
                        </div>
                    <% } %>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a href="/bbs/login" class="btn btn-outline-secondary btn-action">로그인</a>
                        <button type="submit" class="btn btn-primary btn-action">토큰 생성</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
