<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '아이디 찾기' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <%
            var data = typeof formData !== 'undefined' ? formData : {};
            var resultId = typeof foundId !== 'undefined' ? foundId : '';
            var resultMessage = typeof message !== 'undefined' ? message : '';
        %>
        <div class="card board-card auth-card mx-auto">
            <div class="card-header bg-white">
                <h1 class="h4 fw-bold mb-0">아이디 찾기</h1>
            </div>
            <div class="card-body">
                <form action="/bbs/find-id" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="name">이름</label>
                        <input class="form-control" type="text" id="name" name="name" maxlength="100"
                            value="<%= data.name || '' %>" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="email">이메일</label>
                        <input class="form-control" type="email" id="email" name="email" maxlength="200"
                            value="<%= data.email || '' %>" required>
                        <div class="form-text">회원가입 때 입력한 이름과 이메일로 아이디를 확인합니다.</div>
                    </div>

                    <% if (resultId) { %>
                        <div class="alert alert-success">
                            가입된 아이디는 <span class="fw-bold"><%= resultId %></span> 입니다.
                        </div>
                    <% } else if (resultMessage) { %>
                        <div class="alert alert-warning"><%= resultMessage %></div>
                    <% } %>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a href="/bbs/login" class="btn btn-outline-secondary btn-action">로그인</a>
                        <button type="submit" class="btn btn-primary btn-action">아이디 찾기</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
