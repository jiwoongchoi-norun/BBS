<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '내 정보' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <div class="card board-card auth-card mx-auto">
            <div class="card-header bg-white">
                <h1 class="h4 fw-bold mb-0">내 정보</h1>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-secondary">아이디</dt>
                    <dd class="col-sm-8 fw-semibold"><%= userInfo.id %></dd>

                    <dt class="col-sm-4 text-secondary">이름</dt>
                    <dd class="col-sm-8"><%= userInfo.name %></dd>

                    <dt class="col-sm-4 text-secondary">닉네임</dt>
                    <dd class="col-sm-8"><%= userInfo.nickname || '-' %></dd>

                    <dt class="col-sm-4 text-secondary">상태</dt>
                    <dd class="col-sm-8">
                        <span class="badge <%= userInfo.status === 'SUSPENDED' ? 'text-bg-danger' : 'text-bg-success' %>"><%= userInfo.status %></span>
                        <% if (userInfo.status === 'SUSPENDED') { %>
                            <div class="text-danger small mt-1"><%= userInfo.suspendReason || '관리자 정지' %></div>
                        <% } %>
                    </dd>

                    <dt class="col-sm-4 text-secondary">전화번호</dt>
                    <dd class="col-sm-8"><%= userInfo.phone || '-' %></dd>

                    <dt class="col-sm-4 text-secondary">소개</dt>
                    <dd class="col-sm-8 text-break"><%= userInfo.bio || '-' %></dd>

                    <dt class="col-sm-4 text-secondary">정보 갱신일</dt>
                    <dd class="col-sm-8"><%= userInfo.passwordUpdatedAt || '-' %></dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a href="/bbs/list" class="btn btn-outline-secondary btn-action">목록</a>
                <a href="/bbs/updatesignup" class="btn btn-primary btn-action">회원정보 수정</a>
                <button type="button" class="btn btn-outline-danger btn-action" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                    회원 탈퇴
                </button>
            </div>
        </div>

        <div class="modal fade" id="withdrawModal" tabindex="-1" aria-labelledby="withdrawModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form action="/bbs/withdraw" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="modal-header">
                            <h2 class="modal-title h5 fw-bold" id="withdrawModalLabel">회원 탈퇴 확인</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-warning mb-3">
                                탈퇴하면 이 계정으로 다시 로그인할 수 없습니다. 작성한 게시글과 댓글은 과제 데이터 보존을 위해 유지됩니다.
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="withdrawPassword">비밀번호</label>
                                <input class="form-control" type="password" id="withdrawPassword" name="password" required>
                            </div>
                            <div>
                                <label class="form-label fw-semibold" for="withdrawConfirmText">확인 문구</label>
                                <input class="form-control" type="text" id="withdrawConfirmText" name="confirmText"
                                    placeholder="탈퇴" required>
                                <div class="form-text">회원 탈퇴를 진행하려면 "탈퇴"를 입력하세요.</div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">취소</button>
                            <button type="submit" class="btn btn-danger">탈퇴 처리</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
