<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '카테고리 관리' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">카테고리 관리</h1>
                <p class="text-secondary mb-0">게시글 작성 시 사용할 카테고리를 관리합니다.</p>
            </div>
            <a href="/bbs/admin" class="btn btn-outline-secondary px-4">대시보드</a>
        </div>

        <section class="card board-card mb-4">
            <div class="card-body">
                <form action="/bbs/admin/categories/save" method="post" class="row g-3 align-items-end">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="newCategoryName">이름</label>
                        <input class="form-control" id="newCategoryName" name="name" maxlength="80" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="newCategorySlug">Slug</label>
                        <input class="form-control" id="newCategorySlug" name="slug" maxlength="40" pattern="[a-z0-9-]{2,40}" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold" for="newCategoryOrder">순서</label>
                        <input class="form-control" id="newCategoryOrder" name="display_order" type="number" value="100">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">추가</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="card board-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 70px;">번호</th>
                                <th scope="col">카테고리</th>
                                <th scope="col" style="width: 110px;">상태</th>
                                <th scope="col" class="text-end" style="width: 420px;">관리</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% rows.forEach(function(row) { var active = Number(row[4]) === 1; %>
                                <tr>
                                    <td class="text-secondary"><%= row[0] %></td>
                                    <td>
                                        <div class="fw-semibold"><%= row[1] %></div>
                                        <div class="text-secondary small"><%= row[2] %> · 순서 <%= row[3] %></div>
                                    </td>
                                    <td><span class="badge <%= active ? 'text-bg-success' : 'text-bg-light border' %>"><%= active ? '활성' : '비활성' %></span></td>
                                    <td>
                                        <div class="d-flex flex-column gap-2 align-items-end">
                                            <form action="/bbs/admin/categories/save" method="post" class="d-flex flex-wrap justify-content-end gap-2">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="category_id" value="<%= row[0] %>">
                                                <input class="form-control form-control-sm" name="name" value="<%= row[1] %>" maxlength="80" required style="max-width: 120px;">
                                                <input class="form-control form-control-sm" name="slug" value="<%= row[2] %>" maxlength="40" required style="max-width: 120px;">
                                                <input class="form-control form-control-sm" name="display_order" type="number" value="<%= row[3] %>" style="max-width: 90px;">
                                                <button type="submit" class="btn btn-sm btn-outline-primary">수정</button>
                                            </form>
                                            <form action="/bbs/admin/categories/toggle" method="post">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="category_id" value="<%= row[0] %>">
                                                <input type="hidden" name="is_active" value="<%= active ? '0' : '1' %>">
                                                <button type="submit" class="btn btn-sm <%= active ? 'btn-outline-danger' : 'btn-outline-success' %>"><%= active ? '비활성화' : '활성화' %></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if (!rows.length) { %>
                                <tr>
                                    <td colspan="4" class="text-center text-secondary py-5">등록된 카테고리가 없습니다.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
