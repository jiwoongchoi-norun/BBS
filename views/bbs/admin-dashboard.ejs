<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '관리자 대시보드' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">관리자 대시보드</h1>
                <p class="text-secondary mb-0">게시글, 신고, 회원, 카테고리를 관리합니다.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/bbs/admin/posts" class="btn btn-primary px-4">게시글</a>
                <a href="/bbs/admin/reports" class="btn btn-outline-danger px-4">신고</a>
                <a href="/bbs/admin/users" class="btn btn-outline-primary px-4">회원</a>
                <a href="/bbs/admin/categories" class="btn btn-outline-secondary px-4">카테고리</a>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">전체 게시글</div>
                        <div class="h3 mb-0"><%= summary.totalPosts %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">공지글</div>
                        <div class="h3 mb-0"><%= summary.noticePosts %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">숨김 게시글</div>
                        <div class="h3 mb-0"><%= summary.hiddenPosts %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">숨김 댓글</div>
                        <div class="h3 mb-0"><%= summary.hiddenComments %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">대기 신고</div>
                        <div class="h3 mb-0"><%= summary.pendingReports %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">전체 회원</div>
                        <div class="h3 mb-0"><%= summary.totalUsers %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">정지 회원</div>
                        <div class="h3 mb-0"><%= summary.suspendedUsers %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">카테고리</div>
                        <div class="h3 mb-0"><%= summary.totalCategories %></div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
