<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '관리자 대시보드' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">관리자 대시보드</h1>
                <p class="text-secondary mb-0">공지글과 숨김 처리 상태를 관리합니다.</p>
            </div>
            <a href="/bbs/admin/posts" class="btn btn-primary px-4">게시글 관리</a>
        </div>

        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">전체 게시글</div>
                        <div class="h3 mb-0"><%= summary.totalPosts %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">공지글</div>
                        <div class="h3 mb-0"><%= summary.noticePosts %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">숨김 게시글</div>
                        <div class="h3 mb-0"><%= summary.hiddenPosts %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card board-card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">숨김 댓글</div>
                        <div class="h3 mb-0"><%= summary.hiddenComments %></div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
