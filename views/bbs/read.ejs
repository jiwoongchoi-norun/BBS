<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '게시글 읽기' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <%
            var column = rows[0];
            var commentRows = typeof comments !== 'undefined' ? comments : [];
            var activeCommentCount = commentRows.filter(function(comment) {
                return Number(comment[10]) !== 0;
            }).length;
            var fileRows = typeof files !== 'undefined' ? files : [];
            var loginUser = typeof currentUser !== 'undefined' ? currentUser : null;
            var selectedReaction = typeof userReaction !== 'undefined' ? userReaction : '';
            var likeCount = column[6] || 0;
            var dislikeCount = column[7] || 0;
            var isPostOwner = loginUser && (loginUser.id === column[3] || loginUser.name === column[3]);

            function formatFileSize(bytes) {
                bytes = Number(bytes || 0);
                if (bytes >= 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
                if (bytes >= 1024) return Math.ceil(bytes / 1024) + ' KB';
                return bytes + ' B';
            }
        %>
        <div class="card board-card mx-auto content-card">
            <div class="card-header bg-white">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
                    <div>
                        <h1 class="h4 fw-bold mb-2"><%=column[1]%></h1>
                        <div class="text-secondary small">
                            작성자 <span class="fw-semibold"><%=column[3]%></span>
                            <span class="mx-2">|</span>
                            작성일 <%=column[4]%>
                            <span class="mx-2">|</span>
                            조회수 <%=column[5]%>
                            <span class="mx-2">|</span>
                            좋아요 <%=likeCount%>
                            <span class="mx-2">|</span>
                            싫어요 <%=dislikeCount%>
                        </div>
                    </div>
                    <span class="badge text-bg-light border">NO. <%=column[0]%></span>
                </div>
            </div>
            <div class="card-body">
                <div class="board-read-content"><%=column[2]%></div>
            </div>
            <div class="card-body border-top">
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
                    <div class="text-secondary small me-sm-auto">
                        추천 현황: 좋아요 <span class="fw-semibold"><%=likeCount%></span> · 싫어요 <span class="fw-semibold"><%=dislikeCount%></span>
                    </div>
                    <% if (loginUser) { %>
                        <div class="reaction-actions">
                            <form action="/bbs/reaction" method="post" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="bbsno" value="<%=column[0]%>">
                                <input type="hidden" name="reaction_type" value="LIKE">
                                <button type="submit" class="reaction-button reaction-like <%= selectedReaction === 'LIKE' ? 'is-active' : '' %>"
                                    aria-label="좋아요 <%= selectedReaction === 'LIKE' ? '취소' : '선택' %>">
                                    <span class="reaction-icon" aria-hidden="true"></span>
                                    <span class="reaction-count"><%=likeCount%></span>
                                </button>
                            </form>
                            <form action="/bbs/reaction" method="post" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="bbsno" value="<%=column[0]%>">
                                <input type="hidden" name="reaction_type" value="DISLIKE">
                                <button type="submit" class="reaction-button reaction-dislike <%= selectedReaction === 'DISLIKE' ? 'is-active' : '' %>"
                                    aria-label="싫어요 <%= selectedReaction === 'DISLIKE' ? '취소' : '선택' %>">
                                    <span class="reaction-icon" aria-hidden="true"></span>
                                    <span class="reaction-count"><%=dislikeCount%></span>
                                </button>
                            </form>
                        </div>
                    <% } else { %>
                        <a href="/bbs/login" class="btn btn-sm btn-outline-primary">로그인 후 추천</a>
                    <% } %>
                </div>
            </div>
            <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a href="/bbs/list" class="btn btn-outline-secondary btn-action">목록</a>
                <a href="/bbs/update?brdno=<%=column[0]%>" class="btn btn-primary btn-action">수정</a>
                <a href="/bbs/delete?brdno=<%=column[0]%>" class="btn btn-danger btn-action">삭제</a>
            </div>
        </div>

        <section class="card board-card mx-auto content-card mt-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="h5 fw-bold mb-0">첨부파일</h2>
                <span class="badge text-bg-light border"><%= fileRows.length %>개</span>
            </div>
            <div class="card-body">
                <% if (fileRows.length) { %>
                    <div class="list-group list-group-flush border rounded">
                        <% for (var f = 0; f < fileRows.length; f++) {
                            var file = fileRows[f];
                            var fileSize = formatFileSize(file[5]);
                            var fileType = file[6] || '파일 형식 정보 없음';
                        %>
                            <div class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                <div class="min-w-0">
                                    <div class="fw-semibold text-break mb-1"><%= file[2] %></div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 text-secondary small">
                                        <span class="badge text-bg-light border"><%= fileSize %></span>
                                        <span><%= fileType %></span>
                                        <span>등록 <%= file[7] %></span>
                                    </div>
                                </div>
                                <div class="text-md-end flex-shrink-0">
                                    <a class="btn btn-sm btn-primary" href="/bbs/download?fno=<%=file[0]%>">다운로드</a>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="border rounded bg-light p-3 text-secondary">첨부파일이 없습니다.</div>
                <% } %>
            </div>
        </section>

        <section class="card board-card mx-auto content-card mt-4" id="comments">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="h5 fw-bold mb-0">댓글</h2>
                <span class="badge text-bg-light border"><%= activeCommentCount %>개</span>
            </div>
            <div class="card-body">
                <% if (loginUser) { %>
                    <form action="/bbs/wsave" method="post" class="mb-4">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="bbsno" value="<%=column[0]%>">
                        <label class="form-label fw-semibold" for="commentContent">댓글 작성</label>
                        <textarea class="form-control mb-2" id="commentContent" name="content" rows="3" maxlength="4000" required></textarea>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary btn-action">댓글 작성</button>
                        </div>
                    </form>
                <% } else { %>
                    <div class="alert alert-light border mb-4">댓글 작성은 로그인 후 가능합니다.</div>
                <% } %>

                <% if (commentRows.length) { %>
                    <div class="d-flex flex-column gap-2">
                        <% for (var i = 0; i < commentRows.length; i++) {
                            var comment = commentRows[i];
                            var depth = comment[5] || 0;
                            var depthClass = depth === 0 ? '' : depth === 1 ? 'ms-md-4' : 'ms-md-5';
                            var depthLabel = depth === 0 ? '댓글' : '답글';
                            var commentLikeCount = comment[6] || 0;
                            var commentDislikeCount = comment[7] || 0;
                            var updatedAt = comment[9] || '';
                            var isDeletedComment = Number(comment[10]) === 0;
                            var isEditedComment = !!updatedAt && !isDeletedComment;
                            var isMine = !isDeletedComment && loginUser && loginUser.id === comment[3];
                        %>
                            <div class="border rounded p-3 <%= depthClass %> <%= depth > 0 ? 'border-start border-3 bg-light bg-opacity-50' : '' %> <%= isMine ? 'border-primary' : '' %> <%= isDeletedComment ? 'bg-light bg-opacity-75' : '' %>">
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-2 mb-2">
                                    <div class="min-w-0">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <% if (depth > 0) { %>
                                                <span class="text-primary small fw-semibold">&rdsh;</span>
                                            <% } %>
                                            <span class="badge <%= depth > 0 ? 'text-bg-light border' : 'text-bg-secondary' %>"><%= depthLabel %></span>
                                            <span class="fw-semibold"><%= comment[3] %></span>
                                            <% if (isEditedComment) { %>
                                                <span class="badge text-bg-light border">수정됨</span>
                                            <% } %>
                                            <% if (isDeletedComment) { %>
                                                <span class="badge text-bg-light border">삭제됨</span>
                                            <% } %>
                                        </div>
                                        <div class="text-secondary small mt-1">
                                            작성 <%= comment[8] %>
                                            <% if (isEditedComment) { %>
                                                <span class="mx-1">·</span>수정 <%= updatedAt %>
                                            <% } %>
                                        </div>
                                        <% if (isMine) { %>
                                            <span class="badge text-bg-primary mt-2">내 댓글</span>
                                        <% } %>
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                                        <% if (loginUser && !isDeletedComment) { %>
                                            <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#replyForm<%= comment[0] %>">답글</button>
                                        <% } %>
                                        <% if (isMine) { %>
                                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target=".commentEditToggle<%= comment[0] %>" aria-expanded="false" aria-controls="commentContent<%= comment[0] %> editCommentForm<%= comment[0] %>">수정</button>
                                            <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteCommentModal<%= comment[0] %>">삭제</button>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="collapse show commentEditToggle<%= comment[0] %>" id="commentContent<%= comment[0] %>">
                                    <% if (isDeletedComment) { %>
                                        <div class="comment-content mb-0 text-secondary fst-italic text-break">사용자가 삭제한 댓글입니다.</div>
                                    <% } else { %>
                                        <div class="comment-content mb-2 text-break"><%= comment[4] %></div>
                                        <div class="text-secondary small d-flex flex-wrap gap-2">
                                            <span>좋아요 <%= commentLikeCount %></span>
                                            <span>싫어요 <%= commentDislikeCount %></span>
                                        </div>
                                    <% } %>
                                </div>

                                <% if (loginUser && !isDeletedComment) { %>
                                    <div class="collapse mt-3" id="replyForm<%= comment[0] %>">
                                        <form action="/bbs/wreply" method="post" class="border-top pt-3">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="bbsno" value="<%=column[0]%>">
                                            <input type="hidden" name="parent_no" value="<%=comment[0]%>">
                                            <label class="form-label small text-secondary" for="replyContent<%= comment[0] %>">답글 작성</label>
                                            <textarea class="form-control mb-2" id="replyContent<%= comment[0] %>" name="content" rows="2" maxlength="4000" required></textarea>
                                            <div class="text-end">
                                                <button type="submit" class="btn btn-sm btn-primary">저장</button>
                                            </div>
                                        </form>
                                    </div>
                                <% } %>
                                <% if (isMine) { %>
                                    <div class="collapse commentEditToggle<%= comment[0] %>" id="editCommentForm<%= comment[0] %>">
                                        <form action="/bbs/wupdate" method="post" class="mt-2">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="bbsno" value="<%=column[0]%>">
                                            <input type="hidden" name="wno" value="<%=comment[0]%>">
                                            <label class="form-label small text-secondary" for="editCommentContent<%= comment[0] %>">댓글 수정</label>
                                            <textarea class="form-control mb-2" id="editCommentContent<%= comment[0] %>" name="content" rows="3" maxlength="4000" required><%= comment[4] %></textarea>
                                            <div class="d-flex justify-content-end gap-2">
                                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target=".commentEditToggle<%= comment[0] %>">취소</button>
                                                <button type="submit" class="btn btn-sm btn-primary">저장</button>
                                            </div>
                                        </form>
                                    </div>
                                <% } %>
                                <% if (isMine) { %>
                                    <div class="modal fade" id="deleteCommentModal<%= comment[0] %>" tabindex="-1" aria-labelledby="deleteCommentModalLabel<%= comment[0] %>" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered modal-sm">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h2 class="modal-title h6 fw-bold text-danger" id="deleteCommentModalLabel<%= comment[0] %>">댓글 삭제</h2>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-1">정말 이 댓글을 삭제하시겠습니까?</p>
                                                    <p class="text-secondary small mb-0">삭제 후에는 댓글 내용이 숨김 처리됩니다.</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">취소</button>
                                                    <form action="/bbs/wdelete" method="post" class="d-inline">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <input type="hidden" name="bbsno" value="<%=column[0]%>">
                                                        <input type="hidden" name="wno" value="<%=comment[0]%>">
                                                        <button type="submit" class="btn btn-danger btn-sm">삭제</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-center text-secondary py-4">등록된 댓글이 없습니다.</div>
                <% } %>
            </div>
        </section>
        <% if (isPostOwner) { %>
            <div class="modal fade" id="updateConfirmModal" tabindex="-1" aria-labelledby="updateConfirmModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title h6 fw-bold" id="updateConfirmModalLabel">게시글 수정</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                        </div>
                        <div class="modal-body">
                            게시글을 수정하시겠습니까?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">취소</button>
                            <a href="/bbs/update?brdno=<%=column[0]%>" class="btn btn-primary btn-sm">확인</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title h6 fw-bold text-danger" id="deleteConfirmModalLabel">게시글 삭제</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="닫기"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-1">정말 이 게시글을 삭제하시겠습니까?</p>
                            <p class="text-secondary small mb-0">삭제 후에는 복구할 수 없습니다.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">취소</button>
                            <a href="/bbs/delete?brdno=<%=column[0]%>" class="btn btn-danger btn-sm">삭제</a>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </main>
    <%- include('partials/footer') %>

    <% if (isPostOwner) { %>
        <script>
            (function() {
                document.addEventListener('DOMContentLoaded', function() {
                    var updateLink = document.querySelector('a[href="/bbs/update?brdno=<%=column[0]%>"]');
                    var deleteLink = document.querySelector('a[href="/bbs/delete?brdno=<%=column[0]%>"]');
                    var updateModal = new bootstrap.Modal(document.getElementById('updateConfirmModal'));
                    var deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));

                    if (updateLink) {
                        updateLink.addEventListener('click', function(event) {
                            event.preventDefault();
                            updateModal.show();
                        });
                    }

                    if (deleteLink) {
                        deleteLink.addEventListener('click', function(event) {
                            event.preventDefault();
                            deleteModal.show();
                        });
                    }
                });
            })();
        </script>
    <% } else { %>
        <script>
            (function() {
                document.addEventListener('DOMContentLoaded', function() {
                    var updateLink = document.querySelector('a[href="/bbs/update?brdno=<%=column[0]%>"]');
                    var deleteLink = document.querySelector('a[href="/bbs/delete?brdno=<%=column[0]%>"]');

                    if (updateLink) updateLink.remove();
                    if (deleteLink) deleteLink.remove();
                });
            })();
        </script>
    <% } %>
</body>
</html>
