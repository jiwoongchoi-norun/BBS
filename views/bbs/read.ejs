<!DOCTYPE html>
<html>
<%- include('partials/head', { title: 'Read Post' }) %>
<body>
    <%- include('partials/nav') %>

    <main class="container py-4">
<%
    console.log("rows : " + JSON.stringify(rows));
    console.log("rows : " + rows.length);
    var column = rows[0];
%>
        <div class="card mx-auto content-card">
            <div class="card-header bg-white">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h1 class="h4 mb-2"><%=column[1]%></h1>
                        <div class="text-secondary small">
                            작성자 <span class="fw-semibold"><%=column[3]%></span>
                            <span class="mx-2">|</span>
                            작성일 <%=column[4]%>
                        </div>
                    </div>
                    <span class="badge text-bg-light border">NO. <%=column[0]%></span>
                </div>
            </div>
            <div class="card-body">
                <div class="board-read-content"><%=column[2]%></div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <a href="/bbs/list" class="btn btn-secondary">목록</a>
                <a href="/bbs/update?brdno=<%=column[0]%>" class="btn btn-primary">수정</a>
                <a href="/bbs/delete?brdno=<%=column[0]%>" class="btn btn-danger">삭제</a>
            </div>
        </div>
    </main>
</body>
</html>
