<!DOCTYPE html>
<html>
<%- include('partials/head', { title: '회원정보 수정' }) %>

<body>
    <%- include('partials/nav') %>

    <main class="container py-4 py-lg-5">
        <%
            var column = rows[0];
        %>
        <div class="card board-card auth-card mx-auto">
            <div class="card-header bg-white">
                <h1 class="h4 fw-bold mb-0">회원정보 수정</h1>
            </div>
            <div class="card-body">
                <form name="form1" action="/bbs/updatesignsave" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="id">아이디</label>
                        <input class="form-control" type="text" id="id" name="id" maxlength="20" value="<%=column[0]%>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="pw1">비밀번호</label>
                        <input class="form-control" type="password" id="pw1" name="pw1" maxlength="20" value="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="pw2">비밀번호 확인</label>
                        <input class="form-control" type="password" id="pw2" name="pw2" maxlength="20" value="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="name">이름</label>
                        <input class="form-control" type="text" id="name" name="name" maxlength="20" value="<%=column[2]%>">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="email">이메일</label>
                        <input class="form-control" type="email" id="email" name="email" maxlength="20" value="<%=column[3]%>">
                    </div>
                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                        <a href="/bbs/list" class="btn btn-outline-secondary btn-action">목록</a>
                        <button type="submit" class="btn btn-primary btn-action">정보 수정</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
