PORT=3000
HOST=127.0.0.1
NODE_ENV=development
SESSION_SECRET=change-this-session-secret

DATABASE_URL=postgres://bbs:bbs_dev_password@127.0.0.1:5432/bbs
PG_TIMEZONE=Asia/Seoul
AUTH_RATE_LIMIT=20
WRITE_RATE_LIMIT=120
SEED_PASSWORD=Password123!

# DATABASE_URL can be replaced with individual pg settings:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=bbs
# PGUSER=bbs
# PGPASSWORD=bbs_dev_password
# PG_TIMEZONE=Asia/Seoul
