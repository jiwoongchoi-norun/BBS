{
  "name": "bbs",
  "version": "1.0.2",
  "description": "A Node.js, Express, EJS, and PostgreSQL based open source bulletin board system.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiwoongchoi-norun/BBS.git"
  },
  "bugs": {
    "url": "https://github.com/jiwoongchoi-norun/BBS/issues"
  },
  "homepage": "https://github.com/jiwoongchoi-norun/BBS#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "lint": "eslint app.js config/**/*.js db/**/*.js routes/**/*.js playwright.config.js tests/**/*.js bin/www",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "audit": "npm audit --audit-level=moderate",
    "security:semgrep": "semgrep scan --config auto",
    "security:secrets": "gitleaks detect --source . --redact",
    "db:seed": "node scripts/seed-pentest.js",
    "ui:check": "playwright test",
    "verify:app": "node -e \"require('./app'); console.log('app loaded')\"",
    "check": "npm run lint && npm run format:check && npm run audit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "http-errors": "~1.6.3",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3"
  }
}
